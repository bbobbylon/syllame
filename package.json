{
  "name": "syllame",
  "version": "2.0.0",
  "description": "SyllaMe - a MERN app for building course syllabi. This root package is the Express/Mongoose API server; the React client lives in ./client.",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "npm run dev --prefix client",
    "client-install": "npm install --prefix client",
    "dev": "concurrently -n server,client -c blue,green \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix client",
    "test": "node --test \"test/**/*.test.js\"",
    "test:client": "npm test --prefix client",
    "test:all": "npm test && npm run test:client",
    "postinstall": "npm install --prefix client --include=dev",
    "seed": "node scripts/seed.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bbobbylon/syllame.git"
  },
  "author": "Robert C. Oliver, Jr. and Colin J. McClintic",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bbobbylon/syllame/issues"
  },
  "homepage": "https://github.com/bbobbylon/syllame#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "is-empty": "^1.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.1",
    "nodemailer": "^10.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.20.2",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9"
  }
}
