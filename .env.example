# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
#
# MongoDB connection string. For a local MongoDB:  mongodb://127.0.0.1:27017/syllame
# For MongoDB Atlas, use the "Connect your application" string from the Atlas UI.
MONGO_URI=mongodb://127.0.0.1:27017/syllame

# Secret used to sign JSON Web Tokens. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long a login token stays valid (seconds). 86400 = 1 day.
JWT_EXPIRES_IN=86400

# Port the API server listens on. The Vite dev server proxies /api to this port.
PORT=5000

# Set to "production" when serving the built client from Express.
NODE_ENV=development

# Public URL of the app, used in password-reset emails. In development the
# client runs on the Vite port, so point here; in production leave it unset
# and the server uses the request's own origin.
APP_URL=http://localhost:3000

# Optional outgoing mail. Leave SMTP_URL unset to have emails printed to the
# server console instead (handy for grabbing reset links locally).
# SMTP_URL=smtps://username:password@smtp.example.com:465
# MAIL_FROM=SyllaMe <no-reply@example.com>
