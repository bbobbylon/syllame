# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
#
# MongoDB connection string. For a local MongoDB:  mongodb://127.0.0.1:27017/syllame
# For MongoDB Atlas, use the "Connect your application" string from the Atlas UI.
MONGO_URI=mongodb://127.0.0.1:27017/syllame

# Secret used to sign JSON Web Tokens. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long a login token stays valid (seconds). 86400 = 1 day.
JWT_EXPIRES_IN=86400

# Port the API server listens on. The Vite dev server proxies /api to this port.
PORT=5000

# Set to "production" when serving the built client from Express.
NODE_ENV=development
